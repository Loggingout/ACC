# Server
PORT=4000
NODE_ENV=development
# comma-separated list of allowed frontend origins (no spaces needed, trimmed automatically)
CLIENT_ORIGIN=http://localhost:5173,https://acc-ashen.vercel.app,https://www.acheerfulcup.com,https://acheerfulcup.com

# Only production website origins may submit traffic analytics (HTTPS, comma-separated)
ANALYTICS_ALLOWED_ORIGINS=https://www.acheerfulcup.com,https://acheerfulcup.com

# MongoDB (Atlas connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/cheerful)
MONGODB_URI=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (from your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by scripts/createAdmin.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Unosend email API. Verify the sender domain in Unosend before sending.
UNOSEND_API_KEY=
UNOSEND_URL=https://app.unosend.co
UNOSEND_API_URL=
UNOSEND_SENDER_EMAIL=
UNOSEND_SENDER_NAME=A Cheerful Cup

# Unosend email notifications
UNOSEND_API_KEY=
UNOSEND_API_URL=https://api.unosend.co/v1/emails
UNOSEND_SENDER_EMAIL=
UNOSEND_SENDER_NAME=A Cheerful Cup

# Payments/ordering (Square, Stripe, delivery platforms) intentionally left
# unset until a provider is chosen — see src/integrations and src/config.
